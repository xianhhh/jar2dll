<Window x:Class="Jar2Dll.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jar2Dll Studio" Height="820" Width="1180" MinHeight="680" MinWidth="980"
        Background="#F3F6FC" Foreground="#172033" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4,0"/><Setter Property="Background" Value="#E8EDF7"/><Setter Property="BorderBrush" Value="#D4DCEA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DCE7FA"/><Setter Property="BorderBrush" Value="#9CB7E8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></Style.Triggers></Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="18,9"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1D4ED8"/></Trigger></Style.Triggers></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="6"/><Setter Property="BorderBrush" Value="#CBD5E1"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DDE5F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  </Window.Resources>
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330" MinWidth="240"/></Grid.ColumnDefinitions>
    <Grid Grid.ColumnSpan="2" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="440"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Jar2Dll Studio" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Build Java payloads, inspect output, and control experimental native packaging." Foreground="#64748B" Margin="0,4,0,0"/></StackPanel>
      <DockPanel Grid.Column="1" VerticalAlignment="Center"><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseBuilder_Click"/><ComboBox x:Name="LanguageComboBox" DockPanel.Dock="Right" Width="108" Margin="0,0,8,0" SelectedIndex="0" SelectionChanged="LanguageSelectionChanged"><ComboBoxItem Content="English"/><ComboBoxItem Content="中文"/></ComboBox><TextBox x:Name="BuilderPathTextBox" ToolTip="Path to j2d.exe"/></DockPanel>
    </Grid>
    <TabControl Grid.Row="1" Grid.Column="0" Padding="6" Background="Transparent">
      <TabItem Header="Build">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,14,0">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="1 · Java entry" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Drop a JAR anywhere in this window to scan entry points." Foreground="#64748B" Margin="0,3,0,12"/>
              <DockPanel><Button DockPanel.Dock="Right" Content="JAR…" Click="BrowseJar_Click"/><TextBox x:Name="InputJarTextBox" ToolTip="Input JAR"/></DockPanel>
              <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="Main class"/><TextBox x:Name="MainClassTextBox"/></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Method"/><TextBox x:Name="MainMethodTextBox" Text="load"/></StackPanel></Grid>
              <TextBlock Text="Detected entry" Margin="0,10,0,2"/><ComboBox x:Name="EntryPointComboBox" SelectionChanged="EntryPointSelectionChanged"/>
              <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="Signature"/><ComboBox x:Name="MethodSignatureComboBox" SelectedIndex="0"><ComboBoxItem Content="()V  — static void()"/><ComboBoxItem Content="([Ljava/lang/String;)V  — main(String[])"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="ClassLoaders (optional)"/><TextBox x:Name="ClassLoadersTextBox"/></StackPanel></Grid>
              <TextBlock Text="Argument text" Margin="0,10,0,2"/><TextBox x:Name="ArgumentTextBox"/><DockPanel Margin="0,7,0,0"><Button DockPanel.Dock="Right" Content="File…" Click="BrowseArgumentFile_Click"/><TextBox x:Name="ArgumentFileTextBox" ToolTip="Argument file content"/></DockPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="2 · Java dependencies" FontWeight="SemiBold" FontSize="16"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Add JARs…" Click="BrowseLibraries_Click"/><Button Content="Scan folder" Click="ScanLibraryDirectory_Click"/></StackPanel></DockPanel><TextBox x:Name="LibraryJarsTextBox" Margin="0,10,0,6" ToolTip="Additional JARs, separated by semicolon or newline"/><DockPanel><StackPanel DockPanel.Dock="Right"><Button Content="Remove" Click="RemoveLibrary_Click"/><Button Content="Clear" Click="ClearLibraries_Click"/></StackPanel><ListBox x:Name="LibraryListBox" MinHeight="72" BorderBrush="#CBD5E1" BorderThickness="1"/></DockPanel></StackPanel></Border>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="3 · Output" FontWeight="SemiBold" FontSize="16"/><DockPanel Margin="0,10,0,0"><Button DockPanel.Dock="Right" Content="Save as…" Click="BrowseOutput_Click"/><TextBox x:Name="OutputDllTextBox"/></DockPanel><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="Platform"/><ComboBox x:Name="PlatformComboBox" SelectedIndex="0"><ComboBoxItem Content="x64"/><ComboBoxItem Content="Win32"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Configuration"/><ComboBox x:Name="ConfigurationComboBox" SelectedIndex="0"><ComboBoxItem Content="Release"/><ComboBoxItem Content="Debug"/></ComboBox></StackPanel></Grid><CheckBox x:Name="CanDumpCheckBox" Content="Allow DLL → JAR recovery" IsChecked="True" Margin="0,12,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="4 · Native libraries" FontWeight="SemiBold" FontSize="16"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Add DLLs…" Click="BrowseNativeLibraries_Click"/><Button Content="Scan folder" Click="ScanNativeLibraryDirectory_Click"/></StackPanel></DockPanel><DockPanel Margin="0,10,0,6"><ComboBox x:Name="NativeModeComboBox" DockPanel.Dock="Right" Width="190" SelectedIndex="0" SelectionChanged="NativeModeSelectionChanged"><ComboBoxItem Tag="stable" Content="stable (recommended)"/><ComboBoxItem Tag="memory" Content="memory (experimental)"/></ComboBox><TextBox x:Name="NativeLibrariesTextBox" ToolTip="Native DLL paths"/></DockPanel><Border x:Name="MemoryOptionsPanel" Visibility="Collapsed" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="7" Padding="10"><StackPanel><TextBlock Text="Memory mode is experimental · x64 only" FontWeight="SemiBold" Foreground="#9A3412"/><TextBlock Text="Native inputs and DLL resources inside the JAR are reserved for future in-memory mapping." TextWrapping="Wrap" Foreground="#7C2D12" Margin="0,4,0,8"/><CheckBox x:Name="MemoryJarNativesCheckBox" Content="Route JAR-contained DLL resources to Memory modules" IsChecked="True"/><CheckBox x:Name="NativeDebugCheckBox" Content="Enable detailed PE diagnostics" IsChecked="True" Margin="0,5,0,0"/></StackPanel></Border></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="5 · Build workspace" FontWeight="SemiBold" FontSize="16"/><TextBox x:Name="JvmArgumentsTextBox" AcceptsReturn="True" MinHeight="52" Margin="0,10,0,6" ToolTip="One JVM argument per line"/><DockPanel><Button DockPanel.Dock="Right" x:Name="BuildButton" Style="{StaticResource PrimaryButton}" Content="Build DLL" Click="Build_Click"/><Button DockPanel.Dock="Right" Content="Workspace…" Click="BrowseTempDirectory_Click"/><TextBox x:Name="TempDirectoryTextBox"/></DockPanel><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Load config JSON…" Click="LoadBuildConfig_Click"/><Button Content="Save load config…" Click="SaveLoadConfig_Click"/></StackPanel></StackPanel></Border>
          </StackPanel>
        </Grid></ScrollViewer>
      </TabItem>
      <TabItem Header="Inspect &amp; Recover"><Grid Margin="32"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="28"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Source DLL" VerticalAlignment="Center"/><DockPanel Grid.Column="1"><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseInspectDll_Click"/><TextBox x:Name="InspectDllTextBox"/></DockPanel><TextBlock Grid.Row="2" Text="Recovered JAR" VerticalAlignment="Center"/><DockPanel Grid.Row="2" Grid.Column="1"><Button DockPanel.Dock="Right" Content="Save as…" Click="BrowseRecoveredJar_Click"/><TextBox x:Name="RecoveredJarTextBox"/></DockPanel><StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"><Button x:Name="InspectButton" Content="Inspect details" Click="Inspect_Click"/><Button x:Name="RecoverButton" Style="{StaticResource PrimaryButton}" Content="Recover JAR" Click="Recover_Click"/><Button Content="Export config JSON" Click="DumpConfig_Click"/></StackPanel></Grid></TabItem>
      <TabItem Header="Run"><Grid Margin="32"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Source DLL" VerticalAlignment="Center"/><DockPanel Grid.Column="1"><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseRunDll_Click"/><TextBox x:Name="RunDllTextBox"/></DockPanel><TextBlock Grid.Row="2" Text="Arguments" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="RunArgumentsTextBox" AcceptsReturn="True" MinHeight="68"/><TextBlock Grid.Row="4" Text="Argument file" VerticalAlignment="Center"/><DockPanel Grid.Row="4" Grid.Column="1"><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseRunArgumentFile_Click"/><TextBox x:Name="RunArgumentFileTextBox"/></DockPanel><StackPanel Grid.Row="6" Grid.Column="1"><TextBox x:Name="RunJvmArgumentsTextBox" AcceptsReturn="True" MinHeight="44" ToolTip="Extra JVM arguments"/><Button x:Name="RunButton" Style="{StaticResource PrimaryButton}" Content="Run embedded JAR" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Run_Click"/></StackPanel></Grid></TabItem>
    </TabControl>
    <Border Grid.Row="1" Grid.Column="1" Background="#111C35" CornerRadius="12" Padding="14" Margin="14,6,0,6"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="Activity log" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="Build output and diagnostics" Foreground="#A9B9D3" FontSize="11" Margin="0,2,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="Clear" Click="ClearLog_Click"/><CheckBox x:Name="LiveOutputCheckBox" DockPanel.Dock="Right" Content="Live output" IsChecked="True" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Print standard output and errors while the command is running"/></DockPanel><TextBox Grid.Row="1" x:Name="LogTextBox" Margin="0,12,0,0" Background="#0B1222" Foreground="#D1FAE5" BorderThickness="0" IsReadOnly="True" FontFamily="Cascadia Mono" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Grid></Border>
  </Grid>
</Window>
